{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "express", "cors", "dotenv"],
    "allowImportingTsExtensions": true,
  },
  "include": ["src"],
  "ts-node": {
    "transpileOnly": true,
    "esm": true
  }
}
